# Conexão PostgreSQL (Supabase Connection Pooler / PgBouncer)
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres"

# Chaves públicas do projeto Supabase (Client e Middleware)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"

# Chave administrativa do Supabase (uso exclusivo no servidor - NUNCA expor no front-end)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"